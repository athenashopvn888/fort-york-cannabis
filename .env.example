# Fort York menu integration placeholders only.
# Do not put real credentials, tokens, or private connector values in this file.
#
# Production live menu + blob last-known-good:
# - APPS_SCRIPT_URL: Apps Script FYC01 feed (required for a fresh fetch)
# - FORT_YORK_ENABLE_LIVE_MENU=true: fail-closed prebuild writes flowers.json/items.json
# - BLOB_READ_WRITE_TOKEN, or BLOB_STORE_ID with VERCEL_OIDC_TOKEN: private blob LKG
# - If blob env is absent, runtime serves baked flowers.json/items.json and stock-snapshot.json
# - FYC_INVENTORY_LOCAL_ONLY=1 forces the baked/local path even when blob env is present
# - Store code defaults to FYC01 via FYC_STORE_CODE, MENU_STORE_CODE, or NEXT_PUBLIC_MENU_STORE_CODE
NEXT_PUBLIC_MENU_STORE_CODE=FYC01
MENU_STORE_CODE=FYC01
FYC_STORE_CODE=FYC01
FORT_YORK_ENABLE_LIVE_MENU=false
FYC_INVENTORY_LOCAL_ONLY=
APPS_SCRIPT_URL=
MENU_FETCH_TIMEOUT_MS=120000
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
# VERCEL_OIDC_TOKEN is injected by Vercel when OIDC is enabled. Do not commit a value.
